# =============================================================================
# LearnCraft Environment Configuration — copy to .env and adjust
# Safe placeholders only. Never commit real secrets or API keys.
# Works offline: every value below has a local default.
# =============================================================================

# --- Server binding ---------------------------------------------------------
# LOCAL:      APP_HOST=127.0.0.1 (this laptop only)
# LAN/HOTSPOT: APP_HOST=0.0.0.0 (all Wi-Fi / hotspot interfaces; the startup
#             banner prints the actual http://<LAN-IP>:PORT lines — no
#             hard-coded IP needed because hotspot DHCP addresses change).
APP_HOST=127.0.0.1
APP_PORT=5000

# --- Environment ------------------------------------------------------------
# development = permissive CORS "*", debugger opt-in, plain HTTP cookies.
# production  = same-origin only unless CORS_ORIGINS lists an origin,
#               Secure cookies, ProxyFix on, debugger always off.
APP_ENV=development

# --- Required ---------------------------------------------------------------
LEARNCRAFT_SECRET_KEY=change-me-generate-with-python-secrets-token_hex-32
LEARNCRAFT_DB_PATH=data/learncraft.db
LEARNCRAFT_NETWORK_MODE=OFFLINE
LEARNCRAFT_MASTER_URL=

# --- CORS (only needed for a SEPARATE frontend origin) ----------------------
# Same-origin frontend+API (what LearnCraft ships) needs nothing here.
# Development may use "*"; production ignores "*" and stays same-origin only.
# CORS_ORIGINS=
# Example: CORS_ORIGINS=https://learn.example.com

# --- Reverse proxy (production) ---------------------------------------------
# APP_TRUST_PROXY=1 when running behind nginx/Caddy/ingress so Flask reads
# X-Forwarded-Proto/Host for correct https redirects and cookies.

# --- Temporary online sharing (run_server.bat share / run_server.ps1 -Share) --
# Opens a public HTTPS tunnel so any phone can open LearnCraft from any
# network. Nothing below is needed for local/LAN/hotspot use.
# Privacy: the tunnel only relays HTTP traffic to the already-running local
# server — the database and content stay on this machine, and cloudflared/ssh
# need no account at all.
# LEARNCRAFT_SHARE_TOOL=auto        # auto | cloudflared | ngrok | ssh
# LEARNCRAFT_SHARE_HOST=0.0.0.0     # 127.0.0.1 = tunnel only (no LAN exposure)
# LEARNCRAFT_SHARE_QR=1             # 0 disables the scannable QR code
# LEARNCRAFT_SHARE_TIMEOUT=60       # seconds to wait for the public URL

# ---------------------------------------------------------------------------
# Ask AI — cloud + local hybrid
# ---------------------------------------------------------------------------
# Mode: AUTO (default) = cloud when internet + API key are available,
#       local built-in tutor otherwise. ONLINE = cloud only (falls back to
#       local on failure). OFFLINE = never call the cloud.
# LEARNCRAFT_AI_MODE=AUTO

# Cloud provider — set ONE of these API keys (picked in this order):
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...

# Optional custom OpenAI-compatible endpoint (overrides the presets above):
# LEARNCRAFT_AI_CLOUD_URL=https://your-endpoint/v1/chat/completions
# LEARNCRAFT_AI_CLOUD_KEY=your-key

# Optional overrides:
# LEARNCRAFT_AI_CLOUD_MODEL=gpt-4o-mini
# LEARNCRAFT_AI_TEMPERATURE=0.2
# LEARNCRAFT_AI_MAX_TOKENS=500
# LEARNCRAFT_AI_TIMEOUT=20

# Local LLM — auto-detected, no configuration needed:
#   1. Ollama  (http://localhost:11434) — any installed model is used,
#      preference order can be set with LEARNCRAFT_AI_LOCAL_MODELS.
#   2. LM Studio (http://localhost:1234/v1) — OpenAI-compatible local server.
# If neither is running, the built-in retrieval tutor answers locally.
# LEARNCRAFT_AI_LOCAL_MODELS=qwen3:8b,llama3.2
#
# Or point at any custom OpenAI-compatible local server:
# LEARNCRAFT_AI_LOCAL_URL=http://localhost:1234/v1/chat/completions
# LEARNCRAFT_AI_LOCAL_KEY=lm-studio
# LEARNCRAFT_AI_LOCAL_MODEL=local-model
# LEARNCRAFT_AI_LOCAL_TIMEOUT=120

# ---------------------------------------------------------------------------
# External learning ecosystem (optional — learn more in
# docs/integrations/external-learning.md)
# ---------------------------------------------------------------------------
# LearnCraft works with zero configuration here: all eight providers are
# link-outs, and Obsidian deep links are assembled in the student's browser
# using a vault name kept in localStorage (never sent to the server).
#
# Notion Level 2 (optional, server-side only). Never commit a real token and
# never paste one into a browser form — it would be exposed to every user.
# With no token set, the Notion adapter reports Level 1 (link-out only).
# NOTION_API_TOKEN=secret_...

