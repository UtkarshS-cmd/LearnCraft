# LearnCraft Docker Environment Configuration
# Copy this file to docker\.env — the folder that holds docker-compose.yml,
# which is where Docker Compose loads .env from automatically:
#     copy docker\.env.docker.example docker\.env
# (Keeping it at the repo root instead? Run Compose with
#  `docker compose --env-file .env -f docker\docker-compose.yml ...`.)
# The build/start aborts with a message if LEARNCRAFT_SECRET_KEY is unset.
# To use a custom port: APP_PORT=8080 (compose maps host:container automatically)
# NOTE: Dockerfile preserves the repo layout (/app/backend + /app/frontend),
# so container paths below mirror a local checkout.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED - Change this for production!
# ---------------------------------------------------------------------------
LEARNCRAFT_SECRET_KEY=your-secret-key-here-change-in-production

# ---------------------------------------------------------------------------
# Deployment (container always listens on 0.0.0.0; host port is configurable)
# ---------------------------------------------------------------------------
# APP_HOST is forced to 0.0.0.0 inside the container by docker-compose.yml.
APP_PORT=5000
APP_ENV=production
# Same-origin needs no CORS entry. Only set for a separate frontend origin:
# CORS_ORIGINS=https://learn.example.com
# Behind the proxy examples in docs/deployment/production.md keep this on:
APP_TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# Path inside the container where SQLite DB will be stored
LEARNCRAFT_DB_PATH=/app/backend/data/learncraft.db

# ---------------------------------------------------------------------------
# Network Mode
# ---------------------------------------------------------------------------
# OFFLINE = fully offline (default)
# ONLINE = cloud features only
# AUTO = cloud when available, offline fallback
LEARNCRAFT_NETWORK_MODE=OFFLINE

# ---------------------------------------------------------------------------
# Master Server (optional, for multi-instance setups)
# ---------------------------------------------------------------------------
# LEARNCRAFT_MASTER_URL=http://master-server:5000

# ---------------------------------------------------------------------------
# Ask AI - Cloud + Local Hybrid (optional)
# ---------------------------------------------------------------------------
# LEARNCRAFT_AI_MODE=AUTO

# Cloud provider API keys (set ONE of these):
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Email Configuration (optional, for password reset OTPs)
# ---------------------------------------------------------------------------
# LEARNCRAFT_MAIL_HOST=smtp.example.com
# LEARNCRAFT_MAIL_PORT=587
# LEARNCRAFT_MAIL_USERNAME=smtp-user
# LEARNCRAFT_MAIL_PASSWORD=smtp-password
# LEARNCRAFT_MAIL_FROM=no-reply@example.com
